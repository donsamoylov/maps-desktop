{
  "manifest_version": 3,
  "name": "Open in Maps Desktop",
  "short_name": "Maps Desktop",
  "version": "1.1.2",
  "description": "Open Google Maps links in the Maps Desktop app for Mac instead of a browser tab. One click to pause.",
  "permissions": [
    "webNavigation",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open map links in Maps Desktop: on",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "homepage_url": "https://github.com/donsamoylov/maps-desktop"
}
