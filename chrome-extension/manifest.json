{
  "manifest_version": 3,
  "name": "Open in Maps Desktop",
  "short_name": "Maps Desktop",
  "version": "1.4.0",
  "description": "Dark mode for Google Maps in Chrome. On a Mac it also opens Google Maps links in the free Maps Desktop app.",
  "default_locale": "en",
  "permissions": [
    "webNavigation",
    "tabs",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*"
      ],
      "js": [
        "dark-theme.js",
        "theme-page.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.google.com/maps*"
      ],
      "js": [
        "theme-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Open map links in Maps Desktop: on",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "homepage_url": "https://github.com/donsamoylov/maps-desktop"
}
